# 复制为 .env 后修改；公网部署至少改这两项
CBETS_DATA_DIR=./data
CBETS_ADAPTER_MODE=mock
CBETS_CHAIN_MODE=mock

# 管理员密钥：留空等于把规则修改、仲裁、锚定接口对全网开放，上线必须设置
CBETS_ADMIN_KEY=

# 资金口径
CBETS_PLATFORM_FEE_BPS=60
CBETS_ESCROW_HOLD_HOURS=72
CBETS_REVIEW_HOLD_HOURS=168

# 风险阈值
CBETS_BLOCK_THRESHOLD=0.75
CBETS_REVIEW_THRESHOLD=0.45

# 允许跨域的来源，多个用逗号分隔；生产建议写具体域名
CBETS_CORS_ORIGINS=*

# 接真实数币达网关时填（Mock 模式忽略）
CBETS_BASE_URL=
CBETS_APP_ID=
CBETS_APP_SECRET=

CBETS_AUTO_TRAIN=1
CBETS_LOG_LEVEL=INFO
